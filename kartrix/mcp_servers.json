        "executable": "github-mcp-server",
        "assets": {
          "darwin-arm64": {"file": "github-mcp-server_Darwin_arm64.tar.gz", "sha256": "89f6b2e9ea94233996bde92e8369cf7706bb70a9208e1ebd5d7bd4908638c713"},
          "darwin-x86_64": {"file": "github-mcp-server_Darwin_x86_64.tar.gz", "sha256": "02bc66fbc9939695000d51749a1618dc426433b54e116288a20f0efb92987d5c"},
          "linux-arm64": {"file": "github-mcp-server_Linux_arm64.tar.gz", "sha256": "17a14f32a46524e2d9711685534b5f4cb21a9315e394e3e4bcfdfb35f76a9243"},
          "linux-x86_64": {"file": "github-mcp-server_Linux_x86_64.tar.gz", "sha256": "85eefe765c78a065bbd528dd6b680784d69f7f4bb84d89f258801968c83d7ff8"},
          "windows-arm64": {"file": "github-mcp-server_Windows_arm64.zip", "sha256": "902b0a50b05781cf7226750d2c44cd6ff841f2fe2fcd8e584d8415a685601da4"},
