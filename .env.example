# Copy to .env and fill in. Never commit .env.

# --- LLM providers ---
# NVIDIA NIM (default) — free key from https://build.nvidia.com
NVIDIA_API_KEY=
# Hugging Face Inference (fallback) — free token from https://huggingface.co/settings/tokens
HF_TOKEN=

# --- MCP servers ---
# Fine-grained, read-only GitHub token recommended
GITHUB_TOKEN=

# --- Infrastructure ---
POSTGRES_USER=kartrix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kartrix
DATABASE_URL=postgresql+asyncpg://kartrix:change-me@127.0.0.1:5432/kartrix
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# --- Config overrides (optional) ---
# Any config.yaml value: KARTRIX_<SECTION>__<KEY>, e.g. KARTRIX_LLM__MODEL=gpt-4o
# KARTRIX_CONFIG_FILE=path/to/other-config.yaml

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
