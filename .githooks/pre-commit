#!/bin/sh
# Kartrix pre-commit hook: the same lint/type checks CI runs (tests run in CI).
# Enable once per clone:   git config core.hooksPath .githooks
# Skip in an emergency:    git commit --no-verify
set -e

echo "pre-commit: ruff check"
uv run --frozen ruff check .
echo "pre-commit: ruff format --check"
uv run --frozen ruff format --check .
echo "pre-commit: mypy"
uv run --frozen mypy
if [ "$(uv run --frozen python -c 'import sys; print(sys.platform)')" != "linux" ]; then
  echo "pre-commit: mypy as Linux (what CI runs)"
  uv run --frozen mypy --platform linux
fi
